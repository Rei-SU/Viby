{
  "name": "viby",
  "version": "0.2.4",
  "description": "Ad-free, account-free desktop music client",
  "main": "./out/main/index.js",
  "author": "Viby",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-changelog.mjs && electron-vite dev",
    "preview": "node scripts/build-changelog.mjs && electron-vite preview",
    "build": "node scripts/build-changelog.mjs && electron-vite build",
    "changelog": "node scripts/build-changelog.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "runtime": "node scripts/fetch-runtime.mjs",
    "runtime:mac": "node scripts/fetch-runtime.mjs --platform darwin --arch x64 && node scripts/fetch-runtime.mjs --platform darwin --arch arm64",
    "dist:mac": "npm run build && npm run runtime:mac && electron-builder --mac",
    "dist:win": "npm run build && node scripts/fetch-runtime.mjs --platform win32 --arch x64 && electron-builder --win",
    "dist:dir": "npm run build && npm run runtime && electron-builder --dir",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
